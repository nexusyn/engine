# .env do engine de BENCH (isolado). Copie para `.env` e preencha as chaves.
# NUNCA commitar o .env real (já no .gitignore). Segredos via 1Password:
#   op read "<your-secret-manager-path><chave>/credential"
#
# Espelha a config VIVA do bench (o que realmente usamos). Os valores NÃO-segredo
# DEFINEM a metodologia do baseline — só altere sob A/B.

# ── Geração + extração: MiniMax-M3.1-Flash (provider oculto = white-label) ──
LLM_PRIMARY=minimax
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_TIMEOUT=240s
EXTRACT_PROVIDER=minimax
EXTRACT_MODEL=MiniMax-M3.1-Flash
NEXUS_GEN_TEMPORAL_MODEL=minimax/MiniMax-M3.1-Flash
# fallbacks (raramente acionados; primário é MiniMax)
LLM_FALLBACKS=anthropic,ollama-turbo
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT=120s

# ── Embeddings + rerank: Jina hospedado ──
EMBED_PROVIDER=jina
JINA_EMBED_MODEL=jina-embeddings-v5-text-small
JINA_RERANK_MODEL=jina-reranker-v3
RERANKER=jina
EMBED_BATCH_SIZE=128
EMBED_RATE_LIMIT_RPS=20

# ── Flags de retrieval do baseline ──
NEXUS_SESSION_RETRIEVAL=true
NEXUS_DIVERSIFY_COUNTS=true
# Canal de recall por data-âncora (F0 temporal) — default OFF até validar no bench.
# NEXUS_ANCHOR_RECALL=true
# NEXUS_ANCHOR_WINDOW_DAYS=3

# ── Infra ──
HTTP_PORT=8044
HTTP_WRITE_TIMEOUT=600s
LOG_FORMAT=json
LOG_LEVEL=info

# ── Juiz do bench (usado pelos run scripts, NÃO pelo engine) ──
# Os run scripts setam LME_JUDGE_PROVIDER=openrouter + LME_JUDGE_OR_MODEL=google/gemini-2.5-flash.
OPENROUTER_MODEL=google/gemini-3.5-flash

# ── SEGREDOS (preencher via op read; vazio falha o boot) ──
MINIMAX_API_KEY=
JINA_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
# Token de API do engine de bench (gerar após subir a stack — ver README).
NEXUS_API_TOKEN=
DB_PASSWORD=app-secret
APP_USER_PASSWORD=app-secret
