# Nexusyn engine configuration — copy to `.env` and set your credentials.

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
ENGINE_DB_PASSWORD=nexus
APP_USER_PASSWORD=app-secret
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ── HTTP Server ────────────────────────────────────────────
HTTP_PORT=8044

# ── Generation LLM ─────────────────────────────────────────
# Pluggable adapters: openai, anthropic, minimax, gemini, ollama, etc.
LLM_PRIMARY=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Fact & Entity Extraction ───────────────────────────────
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=gpt-4o-mini

# ── Embeddings ─────────────────────────────────────────────
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536
EMBED_BATCH_SIZE=128
EMBED_RATE_LIMIT_RPS=20

# ── Reranking (optional) ───────────────────────────────────
# RERANKER=cohere
# COHERE_API_KEY=

# ── Vector Index ───────────────────────────────────────────
VECTOR_INDEX=hnsw
