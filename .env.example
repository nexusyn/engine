# NEXUS Local — Environment variables (template)
#
# Copie pra .env (gitignored) e preencha. Detalhes em docs/06-config.md (a criar).
#
# ═════════ CONFIG DE PRODUÇÃO (see provider documentation) ═════════
# Embed/rerank = Jina (único provider). A config de PROD é:
#   EMBED_PROVIDER=jina            JINA_EMBED_MODEL=jina-embeddings-v5-text-small
#   RERANKER=jina                  JINA_RERANK_MODEL=jina-reranker-v3
#   EXTRACT_PROVIDER=minimax       EXTRACT_MODEL=MiniMax-M3.1-Flash   (api.minimax.io direto)
#   GERAÇÃO PADRÃO GLOBAL: LLM_PRIMARY=minimax + MINIMAX_MODEL=MiniMax-M3.1-Flash →
#     TODA org (inclusive as criadas por signup self-serve, sem org_model_config)
#     usa M3.1 (MiniMax-M3.1-Flash). org_model_config vira só override pontual.
#   → ESCOLHIDO 2026-05-31 (atualizado 2026-10-16 p/ M3.1): MiniMax pago/flat = custo marginal ZERO (resolve a margem).
#     LongMemEval-S n=96: 81.2% (vs gemini-3.5-flash 87.5% per-token); acima de baselines publicos.
#   ALTERNATIVA paga de +accuracy: EXTRACT=gemini/gemini-2.5-flash-lite + gen gemini-3.5-flash.
#   Chaves (1Password): MINIMAX_API_KEY, JINA_API_KEY, ANTHROPIC_API_KEY (+ GEMINI_API_KEY p/ alt).
#   Retrieval default limit=20 (query.go). NÃO usar Ollama p/ extração (quebra JSON/throttle —
#   lesson_ollama_turbo_unsuitable_extraction). MiniMax-M3.1-Flash é reasoning → extração ~5-18s/sessão
#   (lenta mas async/background) + thinking; gen ~2-6s ok.
# ═══════════════════════════════════════════════════════════════════

# ───── Database ─────
# Em compose: host = postgres (service name)
# Em dev local: host = localhost
#
# 2 URLs por design: separação de privilégio.
#  - DATABASE_URL: runtime (nexus_app — non-superuser, RLS ativa)
#  - ADMIN_DATABASE_URL: migrations apenas (nexus — superuser, DDL rights)
# NUNCA use admin URL em runtime — perde proteção RLS.
#
# FIX 6 (auditoria 2026-07-02): via docker compose, as duas URLs abaixo são
# IGNORADAS em runtime — o compose monta as duas a partir de ENGINE_DB_PASSWORD/
# APP_USER_PASSWORD (ver `environment:` em docker-compose.yml). Preencha aqui só
# se for rodar o binário FORA do compose (dev local, host=localhost). godotenv
# (lib usada por internal/config/config.go) NÃO faz interpolação de ${VAR} — não
# dá pra referenciar ENGINE_DB_PASSWORD/APP_USER_PASSWORD aqui dentro; gere a
# senha e cole nas duas URLs manualmente. Exemplo comentado abaixo.
#   gere com: openssl rand -hex 32
# DATABASE_URL=postgres://nexus_app:<APP_USER_PASSWORD>@localhost:5432/nexus?sslmode=disable
# ADMIN_DATABASE_URL=postgres://nexus:<ENGINE_DB_PASSWORD>@localhost:5432/nexus?sslmode=disable

# Senha do postgres do ENGINE (interpolada no compose como POSTGRES_PASSWORD/ADMIN URL).
# Var ENGINE_* p/ não colidir com DB_PASSWORD do console quando a stack sobe unificada.
#   gere com: openssl rand -hex 32
ENGINE_DB_PASSWORD=
APP_USER_PASSWORD=
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ───── HTTP server ─────
HTTP_PORT=8044
HTTP_READ_TIMEOUT=30s
# 600s pra dar folga ao LLM local CPU (qwen2.5:14b 14B pode levar 60-120s/query)
HTTP_WRITE_TIMEOUT=600s

# ───── Config de modelo GLOBAL (admin-only) ─────
# Chave-mestra (AES-256-GCM) que cifra as API keys de provider salvas via
# /v1/admin/model-config (tela Models do console). Gerar UMA vez e guardar no
# 1Password (<your-secret-manager-path>); se perder/trocar, as keys salvas ficam ilegíveis.
#   Gerar:  openssl rand -base64 32
# Ausente = endpoints /v1/admin/model-config respondem 503 (degradação limpa).
CONFIG_ENC_KEY=
# AUD-024 (rotação de chave): ciphertext é versionado "<id>:base64". Opcionais:
#   CONFIG_ENC_KEY_ID    — id da chave primária (default v1; incremente ao rotacionar).
#   CONFIG_ENC_KEY_RING  — chaves ANTIGAS só pra DECIFRAR durante a rotação (CSV id:base64).
# Rotacionar: nova em CONFIG_ENC_KEY + CONFIG_ENC_KEY_ID=v2 + CONFIG_ENC_KEY_RING=v1:<antiga>.
CONFIG_ENC_KEY_ID=
CONFIG_ENC_KEY_RING=

# ═══════════════════════════════════════════════════════════════════════
# LLM — Três sub-perfis (escolha UM e descomente o bloco)
# ═══════════════════════════════════════════════════════════════════════
#
# Trade-off matriz:
# ┌──────────────────────┬──────────┬──────────┬─────────────┬─────────────┐
# │ Perfil               │ Privacy  │ Custo $  │ Latência    │ RAM local   │
# ├──────────────────────┼──────────┼──────────┼─────────────┼─────────────┤
# │ (a) strict local     │ MÁXIMA   │ R$0      │ 13-120s     │ 10-50 GB    │
# │ (b) local-hybrid Groq│ ALTA*    │ R$0**    │ <1s         │ 0 GB        │
# │ (c) Ollama Cloud     │ ALTA*    │ R$0**    │ 1-3s        │ 0 GB        │
# └──────────────────────┴──────────┴──────────┴─────────────┴─────────────┘
# *  Dados (DB/embeddings) ficam locais; só prompts/chunks vão pro provider
# ** Free tier; rate limit ~30 req/min — suficiente pra uso individual

# NOTA: o provider "ollama-turbo" (env OLLAMA_*) é um slot OpenAI-compatible.
# Atende Ollama local, Ollama Cloud Turbo (ollama.com) E Groq — basta trocar
# OLLAMA_BASE_URL. NÃO é together.xyz (nome legado "together" ainda aceito como
# alias em LLM_PRIMARY por back-compat, mas evite usá-lo).
#
# ─── Perfil (a) strict local — Ollama + qwen2.5:14b ─────────────────────
# Privacy máxima, dados nunca saem da máquina.
# Requer: container ollama + ollama pull qwen2.5:14b (~9 GB disk + RAM)
LLM_PRIMARY=ollama-turbo
LLM_FALLBACKS=
OLLAMA_API_KEY=ollama-noop
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=600s

# ─── Perfil (b) local-hybrid — Groq (free 30 req/min) ───────────────────
# Latência <1s, zero overhead RAM. Free tier permanente.
# Cadastro: console.groq.com → API key (gsk_...)
# Modelos free: llama-3.3-70b-versatile, qwen-qwq-32b, gpt-oss-20b
# LLM_PRIMARY=ollama-turbo
# LLM_FALLBACKS=
# OLLAMA_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OLLAMA_BASE_URL=https://api.groq.com/openai
# OLLAMA_MODEL=llama-3.3-70b-versatile
# OLLAMA_TIMEOUT=60s

# ─── Perfil (c) local-hybrid — Ollama Cloud Turbo ───────────────────────
# Mesmo Ollama API, mas hosted. Free tier limitado.
# Cadastro: ollama.com → conta → API key
# LLM_PRIMARY=ollama-turbo
# LLM_FALLBACKS=
# OLLAMA_API_KEY=ollama_xxxxxxxxxxxxxxxx
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_TIMEOUT=120s

# ═══════════════════════════════════════════════════════════════════════
# Outros providers (multi-fallback se quiser robustez)
# Adicione anthropic/gemini/etc em LLM_FALLBACKS como rede de segurança.
# ═══════════════════════════════════════════════════════════════════════

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=60s

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT=60s

MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_TIMEOUT=60s

# ───── Embeddings (Jina AI hospedado) ─────
# Único provider suportado. jina-embeddings-v5-text-small = 1024 dims (compat
# com o schema vector(1024)). Key via 1Password: JINA_API_KEY.
EMBED_PROVIDER=jina
EMBED_BATCH_SIZE=100
EMBED_RATE_LIMIT_RPS=50

JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v5-text-small
JINA_EMBED_DIMS=1024
JINA_BASE_URL=https://api.jina.ai
JINA_TIMEOUT=60s

# ───── Reranker (Jina AI hospedado) ─────
# RERANKER=jina | none. Usa a MESMA conta/key do embed (JINA_API_KEY).
RERANKER=jina
JINA_RERANK_MODEL=jina-reranker-v3
JINA_RERANK_TIMEOUT=30s

# ───── Vector index ─────
# diskann (prod, ≥10k vectors) | hnsw (dev/test) | none (skip, sequential scan)
VECTOR_INDEX=diskann

# ───── Context limits ─────
CONTEXT_MAX_CHARS_PER_PAGE=25000
CONTEXT_MAX_PAGES=5

# ───── Compile (Karpathy) ─────
COMPILE_AUTO_THRESHOLD_NINGEST=20
COMPILE_CRON_DOMAINS=wiki,knowledge

# ───── Auth ─────
# bcrypt cost (10-12 em prod; 4 em test)
AUTH_BCRYPT_COST=12

# AUD-025: segredo de bootstrap usado por `nexus admin` p/ derivar o master token.
# Use ALTA entropia (≥32 bytes aleatórios) e guarde no 1Password — entropia fraca aqui
# enfraquece o token mestre. Gerar: openssl rand -base64 32
NEXUS_BOOTSTRAP_SECRET=

# ───── Logging ─────
LOG_LEVEL=info
LOG_FORMAT=json

# ───── Observability ─────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexus
OTEL_SERVICE_VERSION=dev
